{
  "configurations": [
    {
      "name": "Win64",
      "compilerPath": "clang-cl.exe",
      "cStandard": "c23",
      "cppStandard": "c++23",
      "intelliSenseMode": "windows-clang-x64",
      "compileCommands": "${workspaceFolder}/.vscode/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/third_party/dkm/include"
      ],
      "defines": [
        "_DEBUG",
        "NOMINMAX",
        "UNICODE",
        "_UNICODE",
        "WIN32_LEAN_AND_MEAN",
        "_WIN32_WINNT=0x0A00",
        "SPDLOG_COMPILED_LIB",
        "yyjson_api_inline=yyjson_inline"
      ]
    }
  ],
  "version": 4
}
